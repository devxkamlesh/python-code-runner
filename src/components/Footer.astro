---
// Footer.astro - Comprehensive developer platform footer conforming to DESIGN.md
---

<footer class="w-full bg-[var(--g-canvas)] border-t border-[var(--g-hairline)] pt-16 pb-12 text-xs">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6">
    
    <!-- Top Grid: 4 Clean Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-[var(--g-hairline)]">
      
      <!-- Brand & Developer Column (spans 2 on lg) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2.5 no-underline group" aria-label="Python Code Runner">
          <div class="w-7 h-7 rounded-[7px] flex items-center justify-center p-1 border border-[var(--g-hairline)] bg-[var(--g-elevated)] shadow-xs">
            <!-- Monochrome Python Logo -->
            <svg class="w-4 h-4 text-[var(--g-ink)]" viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
              <g transform="translate(0 10.26)">
                <path fill="currentColor" d="M63.391 1.988c-4.222.02-8.252.379-11.8 1.007-10.45 1.846-12.346 5.71-12.346 12.837v9.411h24.693v3.137H29.977c-7.176 0-13.46 4.313-15.426 12.521-2.268 9.405-2.368 15.275 0 25.096 1.755 7.311 5.947 12.519 13.124 12.519h8.491V67.234c0-8.151 7.051-15.34 15.426-15.34h24.665c6.866 0 12.346-5.654 12.346-12.548V15.833c0-6.693-5.646-11.72-12.346-12.837-4.244-.706-8.645-1.027-12.866-1.008zM50.037 9.557c2.55 0 4.634 2.117 4.634 4.721 0 2.593-2.083 4.69-4.634 4.69-2.56 0-4.633-2.097-4.633-4.69-.001-2.604 2.073-4.721 4.633-4.721z"/>
                <path fill="currentColor" fill-opacity="0.45" d="M91.682 28.38v10.966c0 8.5-7.208 15.655-15.426 15.655H51.591c-6.756 0-12.346 5.783-12.346 12.549v23.515c0 6.691 5.818 10.628 12.346 12.547 7.816 2.297 15.312 2.713 24.665 0 6.216-1.801 12.346-5.423 12.346-12.547v-9.412H63.938v-3.138h37.012c7.176 0 9.852-5.005 12.348-12.519 2.578-7.735 2.467-15.174 0-25.096-1.774-7.145-5.161-12.521-12.348-12.521h-9.268zM77.809 87.927c2.561 0 4.634 2.097 4.634 4.692 0 2.602-2.074 4.719-4.634 4.719-2.55 0-4.633-2.117-4.633-4.719 0-2.595 2.083-4.692 4.633-4.692z"/>
              </g>
            </svg>
          </div>
          <span class="font-semibold text-sm tracking-[-0.02em] text-[var(--g-ink)]">
            python code runner
          </span>
        </a>

        <p class="text-xs text-[var(--g-mute)] max-w-sm leading-relaxed">
          Client-side Python 3.12 execution in WebAssembly. Evaluates scripts, manages virtual file systems, and installs packages with zero server latency.
        </p>

        <!-- Developer Credit Card -->
        <div class="p-3 rounded-[8px] bg-[var(--g-elevated)] border border-[var(--g-hairline)] max-w-sm">
          <div class="flex items-center gap-2.5">
            <img 
              src="/author.jpg" 
              alt="Kamlesh Choudhary (devxkamlesh)" 
              width="28" 
              height="28" 
              class="w-7 h-7 rounded-full object-cover border border-[var(--g-hairline)] shrink-0" 
              loading="lazy"
            />
            <div class="space-y-0.5 min-w-0">
              <div class="flex items-center gap-1.5 flex-wrap">
                <a href="https://x.com/devxkamlesh" target="_blank" rel="noopener noreferrer" class="font-semibold text-[var(--g-ink)] hover:text-[var(--g-link)] truncate">
                  Kamlesh Choudhary
                </a>
                <span class="text-[10px] text-[var(--g-mute)]">(@devxkamlesh)</span>
              </div>
              <p class="text-[10px] text-[var(--g-mute)] truncate">Full Stack Engineer &amp; AI Systems Architect &middot; MJRPU Jaipur</p>
            </div>
          </div>

          <!-- Social Links -->
          <div class="flex items-center gap-2 mt-2 pt-2 border-t border-[var(--g-hairline)] text-[var(--g-mute)]">
            <a href="https://x.com/devxkamlesh" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--g-ink)] transition-colors p-1" title="X / Twitter">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
              </svg>
            </a>
            <a href="https://github.com/devxkamlesh" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--g-ink)] transition-colors p-1" title="GitHub">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
              </svg>
            </a>
            <a href="https://in.linkedin.com/in/devxkamlesh" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--g-ink)] transition-colors p-1" title="LinkedIn">
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Column 2: Platform -->
      <div class="space-y-3">
        <h4 class="font-semibold text-xs tracking-wider uppercase font-mono text-[var(--g-ink)]">Platform</h4>
        <ul class="space-y-2 text-[var(--g-body)]">
          <li><a href="/" class="hover:text-[var(--g-ink)] transition-colors">WebAssembly runner</a></li>
          <li><a href="/tutorials" class="hover:text-[var(--g-ink)] transition-colors">Interactive tutorials</a></li>
          <li><a href="/#technical-guide" class="hover:text-[var(--g-ink)] transition-colors">Architecture guide</a></li>
          <li><a href="/#faq-section" class="hover:text-[var(--g-ink)] transition-colors">Frequently asked questions</a></li>
          <li><a href="/blog" class="hover:text-[var(--g-ink)] transition-colors">Engineering blog</a></li>
        </ul>
      </div>

      <!-- Column 3: Guides & Docs -->
      <div class="space-y-3">
        <h4 class="font-semibold text-xs tracking-wider uppercase font-mono text-[var(--g-ink)]">Guides</h4>
        <ul class="space-y-2 text-[var(--g-body)]">
          <li><a href="/how-to-run-python-code" class="hover:text-[var(--g-ink)] transition-colors">Online Python execution</a></li>
          <li><a href="/how-to-run-py-file" class="hover:text-[var(--g-ink)] transition-colors">How to run a .py file</a></li>
          <li><a href="/python-code-runner-windows" class="hover:text-[var(--g-ink)] transition-colors">Windows terminal guide</a></li>
          <li><a href="/common-python-errors-faqs" class="hover:text-[var(--g-ink)] transition-colors">Common Python errors</a></li>
          <li><a href="/common-python-errors" class="hover:text-[var(--g-ink)] transition-colors">Syntax troubleshooting</a></li>
        </ul>
      </div>

      <!-- Column 4: Standards & Methodology -->
      <div class="space-y-3">
        <h4 class="font-semibold text-xs tracking-wider uppercase font-mono text-[var(--g-ink)]">Transparency</h4>
        <ul class="space-y-2 text-[var(--g-body)]">
          <li><a href="/methodology" class="hover:text-[var(--g-ink)] transition-colors font-medium text-[var(--g-ink)]">Runtime methodology</a></li>
          <li><a href="/methodology" class="hover:text-[var(--g-ink)] transition-colors">Python 3.12 (PEP 695)</a></li>
          <li><a href="/methodology" class="hover:text-[var(--g-ink)] transition-colors">W3C WebAssembly 2.0</a></li>
          <li><a href="/methodology" class="hover:text-[var(--g-ink)] transition-colors">IEEE 754 precision</a></li>
          <li><a href="/sitemap.xml" class="hover:text-[var(--g-ink)] transition-colors">XML sitemap</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar: Status, Copyright & Verification -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--g-mute)]">
      
      <div class="flex items-center gap-2">
        <span class="font-semibold text-[var(--g-ink)]">python-code-runner.com</span>
        <span>&copy; {new Date().getFullYear()}</span>
        <span>&middot;</span>
        <span>All rights reserved</span>
      </div>

      <!-- Operational Status Badge -->
      <div class="flex items-center gap-2 px-2.5 py-1 rounded-full border border-[var(--g-hairline)] bg-[var(--g-elevated)] text-[11px] text-[var(--g-body)]">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Static client execution &middot; CPython 3.12.7 via Pyodide</span>
      </div>

      <div class="flex items-center gap-2">
        <span>Standards verified by</span>
        <a href="https://x.com/devxkamlesh" target="_blank" rel="noopener noreferrer" class="font-medium text-[var(--g-ink)] hover:text-[var(--g-link)] transition-colors">
          Kamlesh Choudhary
        </a>
      </div>

    </div>

  </div>
</footer>
