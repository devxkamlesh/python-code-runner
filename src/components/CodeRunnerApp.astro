---
// CodeRunnerApp.astro - Core interactive code runner with CodeMirror and Pyodide
---

<div class="w-full max-w-[1400px] mx-auto px-4 sm:px-6 py-6">
  <!-- Top Workspace Bar: Active File & Fast Status -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 mb-4">
    <div>
      <h1 class="text-xl sm:text-2xl font-semibold tracking-[-0.03em] text-[var(--g-ink)] flex items-center gap-2.5">
        <span>Python Code Runner</span>
        <span id="runtime-status-tag" class="text-[11px] font-mono font-medium px-2 py-0.5 rounded-[4px] bg-[var(--g-hairline-soft)] text-[var(--g-body)] border border-[var(--g-hairline)] flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--g-warning)]" id="status-dot"></span>
          <span id="status-text">Wasm Engine Readying...</span>
        </span>
      </h1>
      <p class="text-xs sm:text-sm text-[var(--g-mute)] mt-0.5">Write, test, and run Python 3 scripts directly in your browser with instant client-side execution</p>
    </div>

    <!-- Quick Action Bar -->
    <div class="flex items-center gap-2 flex-wrap">
      <!-- Runtime Version Selector with Animated Transition Indicator -->
      <div class="relative" id="version-dropdown-wrapper">
        <button 
          type="button" 
          id="btn-version-dropdown" 
          class="flex items-center gap-2 bg-[var(--g-elevated)] hover:bg-[var(--g-canvas)] border border-[var(--g-hairline)] px-2.5 py-1.5 rounded-[6px] transition-all cursor-pointer shadow-[var(--g-shadow-sm)] focus:border-[var(--g-ink)]"
          aria-haspopup="true"
          aria-expanded="false"
          title="Select Python Runtime Engine"
        >
          <span class="w-2 h-2 rounded-full bg-[var(--g-success)]" id="version-indicator-dot"></span>
          <span class="text-xs font-mono font-medium text-[var(--g-ink)]" id="active-version-label">Python 3.12</span>
          <span class="text-[10px] font-mono font-medium px-1.5 py-0.2 rounded bg-[var(--g-success-soft)] text-[var(--g-link)] border border-[var(--g-link-soft)]" id="active-version-badge">Default</span>
          <svg id="version-chevron" class="w-3.5 h-3.5 text-[var(--g-mute)] transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div 
          id="version-dropdown-menu" 
          class="hidden absolute right-0 top-full mt-1.5 w-72 bg-[var(--g-elevated)] border border-[var(--g-hairline)] rounded-[8px] shadow-lg z-50 p-1.5 text-xs font-mono animate-pop-in"
        >
          <div class="px-2.5 py-1.5 border-b border-[var(--g-hairline)] text-[11px] text-[var(--g-mute)] flex items-center justify-between">
            <span>Select WebAssembly Engine</span>
            <span class="text-[10px] text-[var(--g-link)]">Client-side Wasm</span>
          </div>

          <div class="flex flex-col gap-1 mt-1" id="version-options-list">
            <button 
              type="button" 
              class="version-option-btn w-full text-left p-2 rounded-[6px] hover:bg-[var(--g-canvas)] flex items-start justify-between transition-colors border border-transparent hover:border-[var(--g-hairline)] cursor-pointer"
              data-version="3.12"
            >
              <div>
                <div class="flex items-center gap-1.5 font-semibold text-[var(--g-ink)]">
                  <span>Python 3.12</span>
                  <span class="text-[10px] px-1.5 py-0.2 rounded bg-[var(--g-link-soft)] text-[var(--g-link)]">Default</span>
                </div>
                <div class="text-[11px] text-[var(--g-mute)] font-sans mt-0.5">CPython 3.12.7 via Pyodide 0.26 (Recommended)</div>
              </div>
              <svg class="version-check-icon w-4 h-4 text-[var(--g-link)] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>

            <button 
              type="button" 
              class="version-option-btn w-full text-left p-2 rounded-[6px] hover:bg-[var(--g-canvas)] flex items-start justify-between transition-colors border border-transparent hover:border-[var(--g-hairline)] cursor-pointer"
              data-version="3.11"
            >
              <div>
                <div class="flex items-center gap-1.5 font-semibold text-[var(--g-ink)]">
                  <span>Python 3.11</span>
                  <span class="text-[10px] px-1.5 py-0.2 rounded bg-[var(--g-success-soft)] text-[var(--g-success)]">LTS</span>
                </div>
                <div class="text-[11px] text-[var(--g-mute)] font-sans mt-0.5">Pyodide 0.24.1 LTS engine for maximum stability</div>
              </div>
              <svg class="version-check-icon w-4 h-4 text-[var(--g-link)] shrink-0 mt-0.5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>

            <button 
              type="button" 
              class="version-option-btn w-full text-left p-2 rounded-[6px] hover:bg-[var(--g-canvas)] flex items-start justify-between transition-colors border border-transparent hover:border-[var(--g-hairline)] cursor-pointer"
              data-version="3.10"
            >
              <div>
                <div class="flex items-center gap-1.5 font-semibold text-[var(--g-ink)]">
                  <span>Python 3.10</span>
                  <span class="text-[10px] px-1.5 py-0.2 rounded bg-[var(--g-warning-soft)] text-[var(--g-warning-deep)]">Legacy</span>
                </div>
                <div class="text-[11px] text-[var(--g-mute)] font-sans mt-0.5">Pyodide 0.23 legacy engine for earlier packages</div>
              </div>
              <svg class="version-check-icon w-4 h-4 text-[var(--g-link)] shrink-0 mt-0.5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>

            <button 
              type="button" 
              class="version-option-btn w-full text-left p-2 rounded-[6px] hover:bg-[var(--g-canvas)] flex items-start justify-between transition-colors border border-transparent hover:border-[var(--g-hairline)] cursor-pointer"
              data-version="3.13"
            >
              <div>
                <div class="flex items-center gap-1.5 font-semibold text-[var(--g-ink)]">
                  <span>Python 3.13</span>
                  <span class="text-[10px] px-1.5 py-0.2 rounded bg-[var(--g-link-soft)] text-[var(--color-brand-violet)]">Preview</span>
                </div>
                <div class="text-[11px] text-[var(--g-mute)] font-sans mt-0.5">Experimental free-threading and JIT preview runtime</div>
              </div>
              <svg class="version-check-icon w-4 h-4 text-[var(--g-link)] shrink-0 mt-0.5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>
          </div>
        </div>

        <!-- Hidden native select for accessibility and script synchronization -->
        <select id="select-python-version" class="hidden">
          <option value="3.12" selected>Python 3.12</option>
          <option value="3.11">Python 3.11</option>
          <option value="3.10">Python 3.10</option>
          <option value="3.13">Python 3.13</option>
        </select>
      </div>

      <!-- Auto-install Missing Packages Toggle Pill Button -->
      <button 
        type="button" 
        id="btn-toggle-autoinstall" 
        class="h-9 px-2.5 bg-[var(--g-elevated)] hover:bg-[var(--g-canvas)] active:bg-[var(--g-hairline-soft)] border border-[var(--g-hairline)] text-[var(--g-ink)] text-xs font-mono rounded-[6px] flex items-center gap-1.5 transition-all cursor-pointer shadow-[var(--g-shadow-sm)]"
        title="Automatically detect and install missing libraries from PyPI on run"
      >
        <span class="w-2 h-2 rounded-full bg-[var(--g-success)]" id="autoinstall-dot"></span>
        <span class="text-[var(--g-body)] hidden sm:inline">Auto-install:</span>
        <span id="autoinstall-status-label" class="font-semibold text-[var(--g-success)]">ON</span>
      </button>

      <!-- Primary Run Button: Marketing Pill per DESIGN.md -->
      <button 
        id="btn-run-code" 
        class="h-9 px-4 btn-primary text-xs font-semibold rounded-full flex items-center gap-2 transition-all shadow-sm cursor-pointer disabled:opacity-50"
        title="Execute Python Code (Ctrl+Enter)"
      >
        <svg id="run-icon-play" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <svg id="run-icon-spinner" class="w-3.5 h-3.5 animate-spin hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Run Script</span>
        <span class="hidden sm:inline-block text-[10px] opacity-75 font-mono">Ctrl+Enter</span>
      </button>

      <!-- Clear Output Button -->
      <button 
        id="btn-clear-console" 
        class="h-9 px-3 bg-[var(--g-elevated)] hover:bg-[var(--g-canvas)] active:bg-[var(--g-hairline-soft)] text-[var(--g-ink)] border border-[var(--g-hairline)] text-xs font-medium rounded-[6px] flex items-center gap-1.5 transition-colors cursor-pointer"
        title="Clear Console Output"
      >
        <svg class="w-3.5 h-3.5 text-[var(--g-body)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
        </svg>
        <span class="hidden sm:inline">Clear</span>
      </button>
    </div>
  </div>

  <!-- Execution Statistics Banner (Time, Memory, Version, Status) -->
  <div class="mb-4 px-3.5 py-2 bg-[var(--g-elevated)] border border-[var(--g-hairline)] rounded-[8px] flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-[var(--g-body)]">
    <div class="flex items-center gap-4 flex-wrap">
      <div>
        <span class="text-[var(--g-mute)]">Time:</span>
        <span id="stat-time" class="font-semibold text-[var(--g-ink)] ml-1">0.000s</span>
      </div>
      <div>
        <span class="text-[var(--g-mute)]">Memory:</span>
        <span id="stat-memory" class="font-semibold text-[var(--g-ink)] ml-1">38.4 MB (Wasm Heap)</span>
      </div>
      <div>
        <span class="text-[var(--g-mute)]">Interpreter:</span>
        <span id="stat-version" class="font-semibold text-[var(--g-ink)] ml-1">Python 3.12</span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-[var(--g-mute)]">Status:</span>
      <span id="stat-status" class="px-2 py-0.5 rounded-[4px] bg-[var(--g-hairline-soft)] text-[var(--g-ink)] font-semibold text-[11px]">Ready</span>
    </div>
  </div>

  <!-- Workspace Grid: Two Columns (Editor on Left, Output/Inspector on Right) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
    
    <!-- LEFT PANE: File Tabs + CodeMirror Editor (Col 7) -->
    <div class="lg:col-span-7 flex flex-col bg-[var(--g-elevated)] border border-[var(--g-hairline)] rounded-[12px] shadow-[var(--g-shadow-sm)] overflow-hidden">
      <!-- File Tabs Header -->
      <div class="flex items-center justify-between bg-[var(--g-canvas)] border-b border-[var(--g-hairline)] px-2 h-10 select-none">
        <div id="file-tabs-list" class="flex items-center gap-1 overflow-x-auto py-1 scrollbar-none">
          <!-- Active file tab injected via JS -->
        </div>

        <!-- Add File and Upload File buttons -->
        <div class="flex items-center gap-1 pl-2">
          <button 
            id="btn-new-file" 
            class="h-7 px-2 text-xs font-medium text-[var(--g-body)] hover:text-[var(--g-ink)] hover:bg-[var(--g-hairline-soft)] rounded-[4px] flex items-center gap-1 transition-colors cursor-pointer"
            title="Create New File"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span class="hidden md:inline">File</span>
          </button>
          
          <label 
            class="h-7 px-2 text-xs font-medium text-[var(--g-body)] hover:text-[var(--g-ink)] hover:bg-[var(--g-hairline-soft)] rounded-[4px] flex items-center gap-1 transition-colors cursor-pointer"
            title="Upload Local File"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <span class="hidden md:inline">Upload</span>
            <input type="file" id="file-upload-input" class="hidden" accept=".py,.txt,.csv,.json" multiple />
          </label>
        </div>
      </div>

      <!-- CodeMirror Editor Container -->
      <div id="cm-editor-container" class="w-full h-[520px] relative text-[14px]"></div>

      <!-- Editor Bottom Status Bar -->
      <div class="flex items-center justify-between px-3 py-1.5 bg-[var(--g-canvas)] border-t border-[var(--g-hairline)] text-[11px] font-mono text-[var(--g-mute)]">
        <div class="flex items-center gap-3">
          <span id="editor-cursor-pos">Ln 1, Col 1</span>
          <span>UTF-8</span>
          <span>Python 3.12</span>
        </div>
        <div class="flex items-center gap-2">
          <button id="btn-autocomplete-code" type="button" class="hover:text-[var(--g-link)] text-[var(--g-body)] transition-colors cursor-pointer flex items-center gap-1" title="Trigger Autocomplete (Ctrl+Space)">
            <svg class="w-3 h-3 text-[var(--g-link)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
            </svg>
            <span>Autocomplete (Ctrl+Space)</span>
          </button>
          <span>|</span>
          <button id="btn-copy-code" class="hover:text-[var(--g-ink)] transition-colors cursor-pointer">
            Copy Code
          </button>
          <span>|</span>
          <button id="btn-format-code" class="hover:text-[var(--g-ink)] transition-colors cursor-pointer">
            Format Code
          </button>
          <span>|</span>
          <span class="text-[var(--g-body)]">Wasm Client-Side</span>
        </div>
      </div>
    </div>

    <!-- RIGHT PANE: Output Console / Variables / Plots / Packages / Input / My Programs (Col 5) -->
    <div class="lg:col-span-5 flex flex-col bg-[var(--g-elevated)] border border-[var(--g-hairline)] rounded-[12px] shadow-[var(--g-shadow-sm)] overflow-hidden">
      <!-- Tabs Header -->
      <div class="flex items-center justify-between bg-[var(--g-canvas)] border-b border-[var(--g-hairline)] px-2 h-10 select-none overflow-x-auto">
        <div class="flex items-center gap-1">
          <button 
            data-target-tab="console" 
            class="tab-btn active px-2.5 py-1 text-xs font-medium rounded-[6px] text-[var(--g-ink)] bg-[var(--g-elevated)] border border-[var(--g-hairline)] shadow-[var(--g-shadow-sm)] cursor-pointer"
          >
            Console
          </button>
          <button 
            data-target-tab="input" 
            class="tab-btn px-2.5 py-1 text-xs font-medium rounded-[6px] text-[var(--g-mute)] hover:text-[var(--g-ink)] transition-colors cursor-pointer"
          >
            Input <span id="input-tab-badge" class="ml-1 text-[10px] font-mono px-1.5 py-0.2 rounded bg-[var(--g-hairline)] text-[var(--g-body)] hidden">0</span>
          </button>
          <button 
            data-target-tab="variables" 
            class="tab-btn px-2.5 py-1 text-xs font-medium rounded-[6px] text-[var(--g-mute)] hover:text-[var(--g-ink)] transition-colors cursor-pointer"
          >
            Variables <span id="var-count-tag" class="ml-1 text-[10px] font-mono opacity-80">0</span>
          </button>
          <button 
            data-target-tab="plots" 
            class="tab-btn px-2.5 py-1 text-xs font-medium rounded-[6px] text-[var(--g-mute)] hover:text-[var(--g-ink)] transition-colors cursor-pointer"
          >
            Plots <span id="plot-count-tag" class="ml-1 text-[10px] font-mono opacity-80">0</span>
          </button>
          <button 
            data-target-tab="packages" 
            class="tab-btn px-2.5 py-1 text-xs font-medium rounded-[6px] text-[var(--g-mute)] hover:text-[var(--g-ink)] transition-colors cursor-pointer"
          >
            Packages
          </button>
          <button 
            data-target-tab="my-programs" 
            class="tab-btn px-2.5 py-1 text-xs font-medium rounded-[6px] text-[var(--g-mute)] hover:text-[var(--g-ink)] transition-colors cursor-pointer"
          >
            My Programs
          </button>
        </div>

        <div class="flex items-center gap-1 pl-1">
          <!-- Copy Output Action -->
          <button 
            id="btn-copy-output" 
            class="h-7 w-7 text-[var(--g-mute)] hover:text-[var(--g-ink)] hover:bg-[var(--g-hairline-soft)] rounded-[4px] flex items-center justify-center transition-colors cursor-pointer"
            title="Copy Console Output"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Tab Content Area (Height matches 520px + bottom bar) -->
      <div class="h-[544px] overflow-hidden flex flex-col bg-[var(--g-elevated)]">
        
        <!-- 1. Console Panel with Educational Error Banner & Persistent Stdin Queue -->
        <div id="panel-console" class="tab-panel h-full flex flex-col font-mono text-xs overflow-hidden">
          <!-- Scrollable Console Terminal Output Area -->
          <div class="flex-1 p-3 overflow-y-auto flex flex-col">
            <!-- Auto-Install Notification Banner -->
            <div id="autoinstall-banner" class="hidden mb-3 p-2.5 rounded-[8px] bg-[var(--g-success-soft)] border border-[var(--g-success)] text-[var(--g-success)] flex items-center justify-between text-xs animate-pop-in">
              <div class="flex items-center gap-2">
                <svg id="autoinstall-spinner" class="w-4 h-4 text-[var(--g-success)] animate-spin shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <div class="leading-tight">
                  <span class="font-semibold" id="autoinstall-banner-pkg">package</span>:
                  <span class="font-normal text-[var(--g-success)]" id="autoinstall-banner-msg">Auto-installing missing library from PyPI...</span>
                </div>
              </div>
              <span class="text-[10px] font-mono bg-[var(--g-success-soft)] text-[var(--g-success)] px-2 py-0.5 rounded border border-[var(--g-success)] shrink-0">micropip</span>
            </div>

            <!-- Educational Error Explanation Card -->
            <div id="error-jump-banner" class="hidden mb-3 p-3 rounded-[8px] bg-[var(--g-error)]/5 border border-[var(--g-error)]/30 text-[var(--g-ink)]">
              <div class="flex items-center justify-between pb-1.5 mb-1.5 border-b border-[var(--g-error)]/20">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold text-[var(--g-error)] font-mono" id="error-title">Python Error</span>
                  <span class="text-[11px] font-mono text-[var(--g-mute)]" id="error-line">Line 1</span>
                </div>
                <button id="btn-jump-error" class="px-2.5 py-0.5 bg-[var(--g-error)] hover:bg-[var(--g-error-deep)] text-white text-[11px] font-medium rounded-[4px] cursor-pointer">
                  Jump to line
                </button>
              </div>
              <p id="error-desc" class="text-xs text-[var(--g-body)] font-sans leading-relaxed">
                Error explanation will appear here.
              </p>
            </div>

            <!-- Console Terminal Output Lines -->
            <div id="console-output" class="flex-1 whitespace-pre-wrap font-mono text-[13px] leading-relaxed text-[var(--g-ink)]">
              <span class="text-[var(--g-mute)]"># Output will appear here after execution...</span>
            </div>
          </div>

          <!-- Persistent Stdin Queue Docked at Bottom of Console -->
          <div class="border-t border-[var(--g-hairline)] bg-[var(--g-canvas)] p-2.5 flex flex-col gap-1.5 shrink-0">
            <div class="flex items-center justify-between">
              <label for="stdin-quick-input" class="text-xs font-semibold text-[var(--g-ink)] flex items-center gap-1.5 cursor-pointer">
                <svg class="w-3.5 h-3.5 text-[var(--g-link)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="4 17 10 11 4 5"></polyline>
                  <line x1="12" y1="19" x2="20" y2="19"></line>
                </svg>
                <span>Input (stdin queue)</span>
              </label>
              <div class="flex items-center gap-2">
                <button type="button" id="btn-autodetect-stdin-quick" class="text-[10px] text-[var(--g-link)] hover:underline cursor-pointer">Auto-detect</button>
                <span id="stdin-line-count-badge" class="text-[10px] font-mono text-[var(--g-mute)]">0 values queued</span>
                <button type="button" id="btn-clear-stdin" class="text-[10px] text-[var(--g-mute)] hover:text-[var(--g-error)] cursor-pointer">Clear</button>
              </div>
            </div>
            <textarea 
              id="stdin-quick-input" 
              rows="3" 
              class="w-full p-2 text-xs font-mono bg-[var(--g-elevated)] border border-[var(--g-hairline)] rounded-[6px] focus:outline-none focus:border-[var(--g-ink)] resize-none leading-relaxed placeholder:text-[var(--g-faint)]"
              placeholder="kamlesh&#10;21&#10;500"
            ></textarea>
          </div>
        </div>

        <!-- 2. Stdin Input Panel -->
        <div id="panel-input" class="tab-panel hidden h-full flex flex-col p-3 overflow-y-auto">
          <div class="pb-2 mb-2 border-b border-[var(--g-hairline)] flex items-center justify-between">
            <div>
              <span class="text-xs font-semibold text-[var(--g-ink)]">Standard Input Queue (stdin)</span>
