          <button type="button" class="preset-ext-btn px-2 py-0.5 text-[10px] font-mono bg-[var(--g-hairline-soft)] hover:bg-[var(--g-hairline)] text-[var(--g-ink)] rounded cursor-pointer transition-colors" data-ext=".py">.py</button>
          <button type="button" class="preset-ext-btn px-2 py-0.5 text-[10px] font-mono bg-[var(--g-hairline-soft)] hover:bg-[var(--g-hairline)] text-[var(--g-ink)] rounded cursor-pointer transition-colors" data-ext=".json">.json</button>
          <button type="button" class="preset-ext-btn px-2 py-0.5 text-[10px] font-mono bg-[var(--g-hairline-soft)] hover:bg-[var(--g-hairline)] text-[var(--g-ink)] rounded cursor-pointer transition-colors" data-ext=".txt">.txt</button>
          <button type="button" class="preset-ext-btn px-2 py-0.5 text-[10px] font-mono bg-[var(--g-hairline-soft)] hover:bg-[var(--g-hairline)] text-[var(--g-ink)] rounded cursor-pointer transition-colors" data-ext=".csv">.csv</button>
        </div>

        <div class="flex items-center justify-end gap-2 pt-2 border-t border-[var(--g-hairline)] mt-1">
          <button 
            type="button" 
            id="btn-custom-prompt-cancel" 
            class="h-8 px-3 text-xs font-medium text-[var(--g-body)] hover:text-[var(--g-ink)] hover:bg-[var(--g-hairline-soft)] rounded-[6px] transition-colors cursor-pointer"
          >
            Cancel
          </button>
          <button 
            type="submit" 
            id="btn-custom-prompt-confirm" 
            class="h-8 px-4 btn-primary text-xs font-medium rounded-[6px] transition-all cursor-pointer shadow-sm"
          >
            Confirm
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Sonner Floating Toast Notification Container -->
  <div id="sonner-toast-container" class="fixed bottom-6 right-6 z-[9999] flex flex-col gap-2.5 pointer-events-none max-w-sm w-full sm:w-[380px]"></div>
  <div id="toast-container" class="fixed bottom-6 right-6 z-[9998] flex flex-col gap-2 pointer-events-none max-w-sm"></div>
</div>

