        <div class="flex items-center gap-2" id="runtime-step-1">
          <span class="step-icon w-4 h-4 rounded-full bg-[var(--g-success)] text-white flex items-center justify-center text-[10px]">✓</span>
          <span class="step-label text-[var(--g-ink)]">Flushing previous WebAssembly memory heap</span>
        </div>
        <div class="flex items-center gap-2" id="runtime-step-2">
          <span class="step-icon w-4 h-4 rounded-full bg-[var(--g-hairline)] text-[var(--g-mute)] flex items-center justify-center text-[10px]">•</span>
          <span class="step-label text-[var(--g-mute)]">Instantiating target CPython runtime engine</span>
        </div>
        <div class="flex items-center gap-2" id="runtime-step-3">
          <span class="step-icon w-4 h-4 rounded-full bg-[var(--g-hairline)] text-[var(--g-mute)] flex items-center justify-center text-[10px]">•</span>
          <span class="step-label text-[var(--g-mute)]">Mounting standard library and virtual filesystem</span>
        </div>
        <div class="flex items-center gap-2" id="runtime-step-4">
          <span class="step-icon w-4 h-4 rounded-full bg-[var(--g-hairline)] text-[var(--g-mute)] flex items-center justify-center text-[10px]">•</span>
          <span class="step-label text-[var(--g-mute)]">Compiling base module namespace</span>
        </div>
      </div>

      <!-- Progress Bar with Percentage -->
      <div class="pt-2 border-t border-[var(--g-hairline)]">
        <div class="flex items-center justify-between text-[11px] font-mono mb-1.5">
