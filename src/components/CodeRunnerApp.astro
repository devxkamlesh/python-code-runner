          </div>
        </div>
        <span id="runtime-modal-timer" class="text-[11px] font-mono text-[var(--g-link)] bg-[var(--g-link-soft)] px-2 py-0.5 rounded-[4px]">0.0s</span>
      </div>

      <!-- Animated Dual-Node Graphic -->
      <div class="my-5 p-3 rounded-[8px] bg-[var(--g-canvas)] border border-[var(--g-hairline)] flex items-center justify-between relative overflow-hidden">
        <!-- Source Version Node -->
        <div class="flex flex-col items-center gap-1 z-10">
          <div class="w-10 h-10 rounded-[8px] bg-[var(--g-elevated)] border border-[var(--g-hairline)] shadow-sm flex items-center justify-center text-xs font-mono font-semibold text-[var(--g-mute)]" id="node-source-version">
            3.12
          </div>
          <span class="text-[10px] font-mono text-[var(--g-mute)]">Previous</span>
        </div>

        <!-- Center Animated Stream -->
        <div class="flex-1 mx-3 flex flex-col items-center justify-center relative">
          <div class="w-full h-1 bg-[var(--g-hairline)] rounded-full relative overflow-hidden">
            <div class="h-full bg-gradient-to-r from-[#0070f3] via-[#7928ca] to-[#50e3c2] w-1/2 rounded-full animate-data-stream"></div>
          </div>
          <span class="text-[10px] font-mono text-[var(--g-link)] mt-1.5 animate-pulse-blink">Swapping Heap...</span>
        </div>

        <!-- Target Version Node -->
        <div class="flex flex-col items-center gap-1 z-10">
          <div class="w-10 h-10 rounded-[8px] bg-[var(--g-elevated)] border-2 border-[var(--g-link)] shadow-md flex items-center justify-center text-xs font-mono font-bold text-[var(--g-link)] animate-ring-pulse" id="node-target-version">
            3.11
          </div>
          <span class="text-[10px] font-mono font-semibold text-[var(--g-link)]">Target</span>
        </div>
      </div>

      <!-- Step Checklist with Animated Checkmarks -->
